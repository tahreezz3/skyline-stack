## Balance simulator (T-0101). Plays many rounds with simulated players of
## different skill and reports perfect rate, collapses, completion and score.
## It uses the real TowerState rules and config, so it answers "what do these
## numbers do?" without a human. It cannot judge *feel*: that needs HR-0017.
##
##   godot --headless --path game --script res://tools/sim_balance.gd -- --rounds=400 [--out=../docs/balance/sim_report.md]
##   ... -- --set=combo.count_cap=8 --set=collapse_costs_life=true   (try values without editing config)
##
## Player model: the player aims at the (swaying) tower top. Landing error is
## normal with sigma = skill_sigma * (crane speed / base speed) combined with
## extra error from sway: sqrt(s^2 + (sway_err * |sway amplitude|)^2).
## Time per block = fall time + half a swing period (waiting for alignment).
extends SceneTree

const TowerState := preload("res://scripts/core/tower_state.gd")
const ConfigLoader := preload("res://scripts/autoload/game_config.gd")

const SKILLS := {"expert": 0.035, "good": 0.07, "average": 0.11, "casual": 0.16, "novice": 0.22}
const SWAY_ERR := 0.5
const ENDLESS_CAP := 300   # safety stop for endless rounds


func _initialize() -> void:
	var rounds := 400
	var out := ""
	var overrides: Array[String] = []
	for arg in OS.get_cmdline_user_args():
		if arg.begins_with("--set="):
			overrides.append(arg.substr(6))
		if arg.begins_with("--rounds="):
			rounds = int(arg.get_slice("=", 1))
		elif arg.begins_with("--out="):
			out = arg.get_slice("=", 1)
	var rules: Dictionary = ConfigLoader.load_json("res://config/tower_rules.json")
	var types: Array = ConfigLoader.load_json("res://config/block_types.json")["types"]
	for o in overrides:
		var key := o.get_slice("=", 0)
		var value: Variant = JSON.parse_string(o.get_slice("=", 1))
		var parts := key.split(".")
		var d: Dictionary = rules
		for i in range(parts.size() - 1):
			d = d[parts[i]]
		d[parts[-1]] = value

	var lines: Array[String] = []
	lines.append("# Balance simulation report")
	lines.append("")
	lines.append("Generated by `game/tools/sim_balance.gd` with %d rounds per cell. Skill = landing error sigma in block widths at base crane speed." % rounds)
	if not overrides.is_empty():
		lines.append("Overrides: `" + ", ".join(overrides) + "`")
	lines.append("")
	lines.append("| Tower | Player (σ) | Complete % | Trophy % | Avg height | Perfect % | Collapses/round | Blocks lost/collapse | Misses/round | Avg population | Combo share % | Avg max combo | Avg round s |")
	lines.append("|---|---|---|---|---|---|---|---|---|---|---|---|---|")
	var cases: Array = []
	for t in types:
		cases.append({"name": t["id"], "round": {"target_height": t["target_height"], "roof_people": t["roof_people"], "star_population": t["star_population"], "star_roof_people": t["star_roof_people"]}})
	cases.append({"name": "endless", "round": {"target_height": 0}})
	for c in cases:
		for skill in SKILLS:
			var r := _simulate(rules, c["round"], SKILLS[skill], rounds, hash(String(c["name"]) + skill))
			lines.append("| %s | %s (%.3f) | %.0f | %.0f | %.1f | %.0f | %.2f | %.2f | %.2f | %.0f | %.0f | %.1f | %.0f |" % [
				c["name"], skill, SKILLS[skill], r["complete"] * 100, r["star"] * 100, r["height"], r["perfect"] * 100,
				r["collapses"], r["lost_per_collapse"], r["misses"], r["population"], r["combo_share"] * 100, r["max_combo"], r["seconds"]])
	var text := "\n".join(lines) + "\n"
	print(text)
	if out != "":
		var f := FileAccess.open(out, FileAccess.WRITE)
		f.store_string(text)
		f.close()
		print("written ", out)
	quit(0)


func _simulate(rules: Dictionary, round_cfg: Dictionary, sigma: float, rounds: int, seed: int) -> Dictionary:
	var rng := RandomNumberGenerator.new()
	rng.seed = seed
	var crane: Dictionary = rules["crane"]
	var sway: Dictionary = rules["sway"]
	var block_h := float(rules["block"]["height"])
	var fall_t := sqrt(2.0 * float(crane["gap_blocks"]) * block_h / float(crane["gravity"]))
	var acc := {"complete": 0.0, "star": 0.0, "height": 0.0, "perfect": 0.0, "landed": 0.0, "collapses": 0.0,
		"lost": 0.0, "misses": 0.0, "population": 0.0, "combo": 0.0, "max_combo": 0.0, "seconds": 0.0}
	for i in range(rounds):
		var s = TowerState.new(rules, round_cfg)
		var seconds := 0.0
		var combo_total := 0
		var blocks := 0
		while not s.is_over and blocks < ENDLESS_CAP:
			blocks += 1
			var speed := minf(float(crane["speed"]) + float(crane["speed_per_block"]) * s.height(), float(crane["speed_max"]))
			var sway_amp := clampf(s.wobble() * float(sway["scale"]), -float(sway["max"]), float(sway["max"]))
			var sig := sqrt(pow(sigma * speed / float(crane["speed"]), 2) + pow(SWAY_ERR * sway_amp, 2))
			var dt := fall_t + PI / speed
			seconds += dt
			combo_total += s.tick(dt)
			if s.is_over:
				break
			var ev: Dictionary = s.land(s.top_x() + rng.randfn(0.0, sig))
			combo_total += int(ev.get("banked", 0))
			match ev["result"]:
				"perfect":
					acc["perfect"] += 1
					acc["landed"] += 1
				"stack":
					acc["landed"] += 1
				"collapse":
					acc["collapses"] += 1
					acc["lost"] += int(ev["removed"])
				"miss":
					acc["misses"] += 1
		if not s.is_over:
			combo_total += s._bank_combo()
		acc["complete"] += 1.0 if s.is_complete else 0.0
		acc["star"] += 1.0 if s.is_star else 0.0
		acc["height"] += s.height()
		acc["population"] += s.population
		acc["combo"] += combo_total
		acc["max_combo"] += s.max_combo
		acc["seconds"] += seconds
	var n := float(rounds)
	return {
		"complete": acc["complete"] / n, "star": acc["star"] / n, "height": acc["height"] / n,
		"perfect": acc["perfect"] / maxf(1.0, acc["landed"]), "collapses": acc["collapses"] / n,
		"lost_per_collapse": acc["lost"] / maxf(1.0, acc["collapses"]), "misses": acc["misses"] / n,
		"population": acc["population"] / n, "combo_share": acc["combo"] / maxf(1.0, acc["population"]),
		"max_combo": acc["max_combo"] / n, "seconds": acc["seconds"] / n,
	}
