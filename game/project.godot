; Engine configuration file.
; Edit through the Godot editor or by hand; keep autoload list in sync with
; docs/02_ARCHITECTURE.md.

config_version=5

[application]

config/name="Skyline Stack (working title)"
config/description="Tower-stacking city builder. See ../README.md."
run/main_scene="res://scenes/main_menu.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "Mobile")

[autoload]

GameConfig="*res://scripts/autoload/game_config.gd"
GameEvents="*res://scripts/autoload/game_events.gd"
SaveData="*res://scripts/autoload/save_data.gd"
SceneRouter="*res://scripts/autoload/scene_router.gd"
AudioDirector="*res://scripts/autoload/audio_director.gd"
Analytics="*res://scripts/autoload/analytics.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=405
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[internationalization]

locale/translations=PackedStringArray("res://localisation/strings.en.translation", "res://localisation/strings.es.translation", "res://localisation/strings.de.translation")
locale/fallback="en"

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
